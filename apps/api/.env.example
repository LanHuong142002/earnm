# Development database (Neon or local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/earnm
# A SEPARATE, empty database used only by tests. Must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/earnm_test
# The test database must be used by ONE test run at a time (tests truncate tables).
PORT=3000
# Reverse-proxy hops to trust for X-Forwarded-For (client IP). 0 locally; when deployed, find the value as described in docs/deploy.md.
TRUST_PROXY=0
# Secret for /internal/* endpoints (Bearer token). Must be 32+ characters or the server refuses to start (the placeholder below is too short on purpose).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" (see docs/deploy.md)
INTERNAL_SECRET=change-me
# Optional. https:// link where an invitee installs the app (e.g. a TestFlight link). Shown on the invite page. Leave empty if there is none; a non-https value stops the server from starting.
INVITE_INSTALL_URL=
# Optional. 32+ characters, no spaces. Hashes invite codes separately from INTERNAL_SECRET. Leave empty to use INTERNAL_SECRET. Changing it voids pending invites.
INVITE_CODE_KEY=
