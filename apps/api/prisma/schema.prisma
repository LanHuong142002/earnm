// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  vi
  en
}

enum Currency {
  VND
  USD
}

enum ProjectRole {
  owner
  member
}

enum TaskStatus {
  todo
  doing
  done
}

enum LabelColour {
  gray
  red
  orange
  yellow
  green
  teal
  blue
  purple
}

model User {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  passwordHash       String
  displayName        String
  language           Language?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  sessions           Session[]
  projects           ProjectMember[]
  invitesCreated     Invite[]                @relation("InviteCreatedBy")
  invitesUsed        Invite[]                @relation("InviteUsedBy")
  createdTasks       Task[]                  @relation("TaskCreator")
  assignments        TaskAssignee[]
  taskComments       TaskComment[]
  taskPhotos         TaskPhoto[]
  remindersCreated   TaskReminder[]          @relation("ReminderCreator")
  reminderRecipients TaskReminderRecipient[]
  pushTokens         DevicePushToken[]
  reminderPushes     ReminderPushSent[]
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Project {
  id                  String              @id
  name                String
  description         String              @default("")
  currency            Currency
  nameEditedAt        DateTime
  descriptionEditedAt DateTime
  currencyEditedAt    DateTime
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  members             ProjectMember[]
  tasks               Task[]
  invites             Invite[]
  labels              Label[]
  deviceSyncs         DeviceProjectSync[]
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime

  @@index([userId])
}

model Task {
  id                  String         @id
  projectId           String
  project             Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  description         String         @default("")
  status              TaskStatus     @default(todo)
  dueDate             DateTime?      @db.Date
  dueTime             String?
  titleEditedAt       DateTime
  descriptionEditedAt DateTime
  statusEditedAt      DateTime
  dueEditedAt         DateTime
  assigneesEditedAt   DateTime
  labelsEditedAt      DateTime       @default(now())
  createdById         String?
  createdBy           User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  assignees           TaskAssignee[]
  checklists          Checklist[]
  labels              TaskLabel[]
  comments            TaskComment[]
  photos              TaskPhoto[]
  reminders           TaskReminder[]

  @@index([projectId])
}

model TaskComment {
  id                 String   @id
  taskId             String
  task               Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId           String?
  author             User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  text               String
  textEditedAt       DateTime @default(now())
  edited             Boolean  @default(false)
  remindWith         Boolean  @default(false)
  remindWithEditedAt DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([taskId, createdAt, id])
}

model TaskPhoto {
  id              String   @id
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  addedById       String?
  addedBy         User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)
  publicId        String   @unique
  width           Int
  height          Int
  caption         String   @default("")
  captionEditedAt DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([taskId, createdAt, id])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codeHash    String    @unique
  createdById String?
  createdBy   User?     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedById    String?
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  revokedAt   DateTime?

  @@index([projectId, createdAt])
}

model Checklist {
  id           String          @id
  taskId       String
  task         Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name         String
  nameEditedAt DateTime
  createdAt    DateTime        @default(now())
  items        ChecklistItem[]

  @@index([taskId, createdAt])
}

model ChecklistItem {
  id           String    @id
  checklistId  String
  checklist    Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text         String
  textEditedAt DateTime
  done         Boolean   @default(false)
  doneEditedAt DateTime
  createdAt    DateTime  @default(now())

  @@index([checklistId, createdAt])
}

model Label {
  id             String      @id
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  nameKey        String
  colour         LabelColour
  nameEditedAt   DateTime
  colourEditedAt DateTime
  createdAt      DateTime    @default(now())
  tasks          TaskLabel[]

  @@unique([projectId, nameKey])
}

model TaskLabel {
  taskId  String
  labelId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

enum ReminderRepeat {
  once
  daily
  weekly
  monthly
}

model TaskReminder {
  id                 String                  @id
  taskId             String
  task               Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startDate          DateTime                @db.Date
  time               String
  timezone           String
  repeat             ReminderRepeat
  weekdays           Int[]                   @default([])
  endDate            DateTime?               @db.Date
  scheduleEditedAt   DateTime                @default(now())
  recipientsEditedAt DateTime                @default(now())
  changedAt          DateTime                @default(now())
  createdById        String?
  createdBy          User?                   @relation("ReminderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime                @default(now())
  recipients         TaskReminderRecipient[]
  pushesSent         ReminderPushSent[]

  @@index([taskId])
}

model TaskReminderRecipient {
  reminderId String
  reminder   TaskReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reminderId, userId])
  @@index([userId])
}

model DevicePushToken {
  token        String              @id
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * Unused: per-project sync times live in DeviceProjectSync.
   */
  lastSyncedAt DateTime?
  createdAt    DateTime            @default(now())
  projectSyncs DeviceProjectSync[]

  @@index([userId])
}

/**
 * When a phone last fetched a project's reminders, so the tick knows it has them scheduled.
 */
model DeviceProjectSync {
  token        String
  device       DevicePushToken @relation(fields: [token], references: [token], onDelete: Cascade)
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastSyncedAt DateTime        @default(now())

  @@id([token, projectId])
  @@index([projectId])
}

model ReminderPushSent {
  reminderId    String
  reminder      TaskReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrenceAt  DateTime
  /// When the claim was made.
  claimedAt     DateTime     @default(now())
  /// When the latest send attempt started; retries wait after it.
  lastAttemptAt DateTime     @default(now())
  /// Send attempts so far; a claim is retried while below 3.
  attempts      Int          @default(1)
  /// Null while claimed and not yet settled; set once the push service accepted a message, or when every failed message was for a token that is no longer registered (those tokens are deleted, so nothing is left to retry).
  sentAt        DateTime?

  @@id([reminderId, userId, occurrenceAt])
  @@index([sentAt, claimedAt])
}

/// One row (id "tick"): when the last /internal/tick ran, so the next one knows how far back to look.
model TickState {
  id         String   @id @default("tick")
  lastTickAt DateTime @default(now())
}
