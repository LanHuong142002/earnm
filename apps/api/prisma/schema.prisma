// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  vi
  en
}

enum Currency {
  VND
  USD
}

enum ProjectRole {
  owner
  member
}

enum TaskStatus {
  todo
  doing
  done
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  displayName  String
  language     Language?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     Session[]
  projects     ProjectMember[]
  createdTasks Task[]          @relation("TaskCreator")
  assignments  TaskAssignee[]
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Project {
  id                  String          @id
  name                String
  description         String          @default("")
  currency            Currency
  nameEditedAt        DateTime
  descriptionEditedAt DateTime
  currencyEditedAt    DateTime
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  members             ProjectMember[]
  tasks               Task[]
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime

  @@index([userId])
}

model Task {
  id                  String         @id
  projectId           String
  project             Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  description         String         @default("")
  status              TaskStatus     @default(todo)
  dueDate             DateTime?      @db.Date
  dueTime             String?
  titleEditedAt       DateTime
  descriptionEditedAt DateTime
  statusEditedAt      DateTime
  dueEditedAt         DateTime
  assigneesEditedAt   DateTime
  createdById         String?
  createdBy           User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  assignees           TaskAssignee[]

  @@index([projectId])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}
