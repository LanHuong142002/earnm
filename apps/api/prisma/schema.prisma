// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  vi
  en
}

enum Currency {
  VND
  USD
}

enum ProjectRole {
  owner
  member
}

enum IdeaStatus {
  new
  considering
  accepted
  dropped
}

enum TaskStatus {
  todo
  doing
  done
}

enum LabelColour {
  gray
  red
  orange
  yellow
  green
  teal
  blue
  purple
}

model User {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  passwordHash       String
  displayName        String
  language           Language?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  sessions           Session[]
  projects           ProjectMember[]
  invitesCreated     Invite[]                @relation("InviteCreatedBy")
  invitesUsed        Invite[]                @relation("InviteUsedBy")
  createdTasks       Task[]                  @relation("TaskCreator")
  assignments        TaskAssignee[]
  taskComments       TaskComment[]
  taskPhotos         TaskPhoto[]
  remindersCreated   TaskReminder[]          @relation("ReminderCreator")
  reminderRecipients TaskReminderRecipient[]
  pushTokens         DevicePushToken[]
  reminderPushes     ReminderPushSent[]
  ideas              Idea[]
  ingredientPrices   IngredientPrice[]
  ideaVotes          IdeaVote[]
  ideaComments       IdeaComment[]
  ideaPhotos         IdeaPhoto[]
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Project {
  id                   String              @id
  name                 String
  description          String              @default("")
  currency             Currency
  nameEditedAt         DateTime
  descriptionEditedAt  DateTime
  currencyEditedAt     DateTime
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  members              ProjectMember[]
  tasks                Task[]
  invites              Invite[]
  labels               Label[]
  deviceSyncs          DeviceProjectSync[]
  ideas                Idea[]
  ingredients          Ingredient[]
  products             Product[]
  extraCosts           ExtraCost[]
  fixedCosts           FixedCost[]
  /// Whole percent, 1-95. Drives the price hint on products.
  targetMargin         Int                 @default(65)
  targetMarginEditedAt DateTime            @default(now())
  /// Expected cups sold per month, 1-1,000,000, or null when not set. Spreads the fixed costs over each cup.
  expectedCupsPerMonth Int?
  expectedCupsEditedAt DateTime            @default(now())
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime

  @@index([userId])
}

model Task {
  id                  String         @id
  projectId           String
  project             Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  description         String         @default("")
  status              TaskStatus     @default(todo)
  dueDate             DateTime?      @db.Date
  dueTime             String?
  titleEditedAt       DateTime
  descriptionEditedAt DateTime
  statusEditedAt      DateTime
  dueEditedAt         DateTime
  assigneesEditedAt   DateTime
  labelsEditedAt      DateTime       @default(now())
  createdById         String?
  createdBy           User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  assignees           TaskAssignee[]
  checklists          Checklist[]
  labels              TaskLabel[]
  comments            TaskComment[]
  photos              TaskPhoto[]
  reminders           TaskReminder[]
  fromIdea            Idea?          @relation("IdeaTask")

  @@index([projectId])
}

model TaskComment {
  id                 String   @id
  taskId             String
  task               Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId           String?
  author             User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  text               String
  textEditedAt       DateTime @default(now())
  edited             Boolean  @default(false)
  remindWith         Boolean  @default(false)
  remindWithEditedAt DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([taskId, createdAt, id])
}

model TaskPhoto {
  id              String   @id
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  addedById       String?
  addedBy         User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)
  publicId        String   @unique
  width           Int
  height          Int
  caption         String   @default("")
  captionEditedAt DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([taskId, createdAt, id])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codeHash    String    @unique
  createdById String?
  createdBy   User?     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedById    String?
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  revokedAt   DateTime?

  @@index([projectId, createdAt])
}

model Checklist {
  id           String          @id
  taskId       String
  task         Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name         String
  nameEditedAt DateTime
  createdAt    DateTime        @default(now())
  items        ChecklistItem[]

  @@index([taskId, createdAt])
}

model ChecklistItem {
  id           String    @id
  checklistId  String
  checklist    Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text         String
  textEditedAt DateTime
  done         Boolean   @default(false)
  doneEditedAt DateTime
  createdAt    DateTime  @default(now())

  @@index([checklistId, createdAt])
}

model Label {
  id             String      @id
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  nameKey        String
  colour         LabelColour
  nameEditedAt   DateTime
  colourEditedAt DateTime
  createdAt      DateTime    @default(now())
  tasks          TaskLabel[]
  ideas          IdeaLabel[]

  @@unique([projectId, nameKey])
}

model TaskLabel {
  taskId  String
  labelId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}

enum ReminderRepeat {
  once
  daily
  weekly
  monthly
}

model TaskReminder {
  id                 String                  @id
  taskId             String
  task               Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startDate          DateTime                @db.Date
  time               String
  timezone           String
  repeat             ReminderRepeat
  weekdays           Int[]                   @default([])
  endDate            DateTime?               @db.Date
  scheduleEditedAt   DateTime                @default(now())
  recipientsEditedAt DateTime                @default(now())
  changedAt          DateTime                @default(now())
  createdById        String?
  createdBy          User?                   @relation("ReminderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime                @default(now())
  recipients         TaskReminderRecipient[]
  pushesSent         ReminderPushSent[]

  @@index([taskId])
}

model TaskReminderRecipient {
  reminderId String
  reminder   TaskReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reminderId, userId])
  @@index([userId])
}

model DevicePushToken {
  token        String              @id
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * Unused: per-project sync times live in DeviceProjectSync.
   */
  lastSyncedAt DateTime?
  createdAt    DateTime            @default(now())
  projectSyncs DeviceProjectSync[]

  @@index([userId])
}

/**
 * When a phone last fetched a project's reminders, so the tick knows it has them scheduled.
 */
model DeviceProjectSync {
  token        String
  device       DevicePushToken @relation(fields: [token], references: [token], onDelete: Cascade)
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastSyncedAt DateTime        @default(now())

  @@id([token, projectId])
  @@index([projectId])
}

model ReminderPushSent {
  reminderId    String
  reminder      TaskReminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrenceAt  DateTime
  /// When the claim was made.
  claimedAt     DateTime     @default(now())
  /// When the latest send attempt started; retries wait after it.
  lastAttemptAt DateTime     @default(now())
  /// Send attempts so far; a claim is retried while below 3.
  attempts      Int          @default(1)
  /// Null while claimed and not yet settled; set once the push service accepted a message, or when every failed message was for a token that is no longer registered (those tokens are deleted, so nothing is left to retry).
  sentAt        DateTime?

  @@id([reminderId, userId, occurrenceAt])
  @@index([sentAt, claimedAt])
}

/// One row (id "tick"): when the last /internal/tick ran, so the next one knows how far back to look.
model TickState {
  id         String   @id @default("tick")
  lastTickAt DateTime @default(now())
}

model Idea {
  id                  String        @id
  projectId           String
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId            String?
  author              User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title               String
  description         String        @default("")
  status              IdeaStatus    @default(new)
  titleEditedAt       DateTime      @default(now())
  descriptionEditedAt DateTime      @default(now())
  statusEditedAt      DateTime      @default(now())
  labelsEditedAt      DateTime      @default(now())
  taskId              String?       @unique
  task                Task?         @relation("IdeaTask", fields: [taskId], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  labels              IdeaLabel[]
  votes               IdeaVote[]
  comments            IdeaComment[]
  photos              IdeaPhoto[]

  @@index([projectId, createdAt])
}

model IdeaLabel {
  ideaId  String
  labelId String
  idea    Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([ideaId, labelId])
  @@index([labelId])
}

model IdeaVote {
  ideaId String
  userId String
  value  Int
  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ideaId, userId])
}

model IdeaComment {
  id           String   @id
  ideaId       String
  idea         Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  text         String
  textEditedAt DateTime @default(now())
  edited       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([ideaId, createdAt, id])
}

model IdeaPhoto {
  id              String   @id
  ideaId          String
  idea            Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  addedById       String?
  addedBy         User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)
  publicId        String   @unique
  width           Int
  height          Int
  caption         String   @default("")
  captionEditedAt DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([ideaId, createdAt, id])
}

enum IngredientMode {
  weight
  volume
  portion
}

/// Quantity is in base units (g, ml, portion); `unit` is the one the person last chose, for display.
/// Price is an integer in the currency's smallest unit. quantity, unit and price are one
/// last-write-wins field, `purchase`.
model Ingredient {
  id               String            @id
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  nameKey          String
  mode             IngredientMode
  quantity         Decimal           @db.Decimal(12, 3)
  unit             String
  price            Int
  isDefault        Boolean           @default(false)
  nameEditedAt     DateTime          @default(now())
  modeEditedAt     DateTime          @default(now())
  purchaseEditedAt DateTime          @default(now())
  defaultEditedAt  DateTime          @default(now())
  createdAt        DateTime          @default(now())
  prices           IngredientPrice[]
  recipeLines      RecipeLine[]

  @@unique([projectId, nameKey])
  @@index([projectId, createdAt])
}

/// The latest few purchases of an ingredient; the newest is its current price.
model IngredientPrice {
  id           Int        @id @default(autoincrement())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Decimal    @db.Decimal(12, 3)
  unit         String
  price        Int
  authorId     String?
  author       User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  recordedAt   DateTime   @default(now())

  @@index([ingredientId, recordedAt])
}

enum ProductSize {
  S
  M
  L
}

model Product {
  id            String           @id
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  nameKey       String
  nameEditedAt  DateTime         @default(now())
  /// The set of sizes is one last-write-wins field.
  sizesEditedAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  sizes         ProductSizeRow[]

  @@unique([projectId, nameKey])
  @@index([projectId, createdAt])
}

/// One size (S, M or L) of a product. The recipe lines and extra lines together are one
/// last-write-wins field, `lines`.
model ProductSizeRow {
  id            String       @id
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          ProductSize
  /// Integer in the currency's smallest unit; null until set.
  sellingPrice  Int?
  priceEditedAt DateTime     @default(now())
  linesEditedAt DateTime     @default(now())
  lines         RecipeLine[]
  extras        SizeExtra[]

  @@unique([productId, size])
}

/// Amount is in the ingredient's base unit (g, ml, portion). An ingredient used here can't be deleted.
model RecipeLine {
  id           String         @id
  sizeId       String
  sizeRow      ProductSizeRow @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  amount       Decimal        @db.Decimal(12, 3)
  included     Boolean        @default(true)
  isDefault    Boolean        @default(false)
  position     Int            @default(0)

  @@unique([sizeId, ingredientId])
  @@index([ingredientId])
}

/// A copy of an extra cost on one size; later changes to the project's extra cost don't touch it.
model SizeExtra {
  id          String         @id
  sizeId      String
  sizeRow     ProductSizeRow @relation(fields: [sizeId], references: [id], onDelete: Cascade)
  name        String
  amount      Int
  included    Boolean        @default(true)
  isDefault   Boolean        @default(false)
  position    Int            @default(0)
  extraCostId String?
  extraCost   ExtraCost?     @relation(fields: [extraCostId], references: [id], onDelete: SetNull)

  @@index([sizeId])
  @@index([extraCostId])
}

enum FixedCostKind {
  monthly
  weekly
  oneTime
}

/// A cost that does not depend on cups sold (rent, wages, equipment). `months` is set only for `oneTime`.
model FixedCost {
  id             String        @id
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  nameKey        String
  kind           FixedCostKind
  amount         Int
  months         Int?
  nameEditedAt   DateTime      @default(now())
  kindEditedAt   DateTime      @default(now())
  amountEditedAt DateTime      @default(now())
  monthsEditedAt DateTime      @default(now())
  createdAt      DateTime      @default(now())

  @@unique([projectId, nameKey])
  @@index([projectId, createdAt])
}

/// A project-wide cost per cup (ice, water...). Integer amount in the currency's smallest unit.
model ExtraCost {
  id              String      @id
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  amount          Int
  isDefault       Boolean     @default(false)
  nameEditedAt    DateTime    @default(now())
  amountEditedAt  DateTime    @default(now())
  defaultEditedAt DateTime    @default(now())
  createdAt       DateTime    @default(now())
  sizeExtras      SizeExtra[]

  @@index([projectId, createdAt])
}
