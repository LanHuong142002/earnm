// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Language {
  vi
  en
}

enum Currency {
  VND
  USD
}

enum ProjectRole {
  owner
  member
}

enum TaskStatus {
  todo
  doing
  done
}

enum LabelColour {
  gray
  red
  orange
  yellow
  green
  teal
  blue
  purple
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  displayName    String
  language       Language?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sessions       Session[]
  projects       ProjectMember[]
  invitesCreated Invite[]        @relation("InviteCreatedBy")
  invitesUsed    Invite[]        @relation("InviteUsedBy")
  createdTasks   Task[]          @relation("TaskCreator")
  assignments    TaskAssignee[]
  taskComments   TaskComment[]
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Project {
  id                  String          @id
  name                String
  description         String          @default("")
  currency            Currency
  nameEditedAt        DateTime
  descriptionEditedAt DateTime
  currencyEditedAt    DateTime
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  members             ProjectMember[]
  tasks               Task[]
  invites             Invite[]
  labels              Label[]
}

model Session {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  lastUsedAt DateTime

  @@index([userId])
}

model Task {
  id                  String         @id
  projectId           String
  project             Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title               String
  description         String         @default("")
  status              TaskStatus     @default(todo)
  dueDate             DateTime?      @db.Date
  dueTime             String?
  titleEditedAt       DateTime
  descriptionEditedAt DateTime
  statusEditedAt      DateTime
  dueEditedAt         DateTime
  assigneesEditedAt   DateTime
  labelsEditedAt      DateTime       @default(now())
  createdById         String?
  createdBy           User?          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  assignees           TaskAssignee[]
  checklists          Checklist[]
  labels              TaskLabel[]
  comments            TaskComment[]

  @@index([projectId])
}

model TaskComment {
  id                 String   @id
  taskId             String
  task               Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId           String?
  author             User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  text               String
  textEditedAt       DateTime @default(now())
  edited             Boolean  @default(false)
  remindWith         Boolean  @default(false)
  remindWithEditedAt DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([taskId, createdAt, id])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Invite {
  id          String    @id @default(uuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  codeHash    String    @unique
  createdById String?
  createdBy   User?     @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedById    String?
  usedBy      User?     @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  usedAt      DateTime?
  revokedAt   DateTime?

  @@index([projectId, createdAt])
}

model Checklist {
  id           String          @id
  taskId       String
  task         Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name         String
  nameEditedAt DateTime
  createdAt    DateTime        @default(now())
  items        ChecklistItem[]

  @@index([taskId, createdAt])
}

model ChecklistItem {
  id           String    @id
  checklistId  String
  checklist    Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text         String
  textEditedAt DateTime
  done         Boolean   @default(false)
  doneEditedAt DateTime
  createdAt    DateTime  @default(now())

  @@index([checklistId, createdAt])
}

model Label {
  id             String      @id
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  nameKey        String
  colour         LabelColour
  nameEditedAt   DateTime
  colourEditedAt DateTime
  createdAt      DateTime    @default(now())
  tasks          TaskLabel[]

  @@unique([projectId, nameKey])
}

model TaskLabel {
  taskId  String
  labelId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
}
